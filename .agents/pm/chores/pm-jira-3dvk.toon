  test/release-workflow.test.ts,project
tests[3]{command,scope,provenance{author,created_at,source_kind,source_ref}}:
  node --test --test-concurrency=2 test/release-workflow.test.ts,project,codex-agent,"2026-11-24T00:57:15.409Z",local_mutation,fix/changelog-keep-dependency-updates
  "npm run changelog:check",project,codex-agent,"2026-11-24T00:57:16.898Z",local_mutation,fix/changelog-keep-dependency-updates
  "npm run verify:release-changelog-date",project,codex-agent,"2026-11-24T00:57:18.972Z",local_mutation,fix/changelog-keep-dependency-updates

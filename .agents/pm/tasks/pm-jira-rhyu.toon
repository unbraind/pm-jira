closed_at: "2026-07-13T20:15:09.520Z"
author: pi-jira-fix
resolution: "Preview routed to stderr; return enriched with {dryRun,plan}"
expected_result: pm jira export --json emits a single valid JSON object containing all payloads
actual_result: "Before fix: stdout was a JSON array followed by trailing YAML (unparseable). After fix: stdout is only the host render; --json is clean+complete"
close_reason: "Preview routed to stderr; return enriched with {dryRun,plan}"

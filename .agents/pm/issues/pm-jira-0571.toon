tests[1]{command,scope,timeout_seconds,pm_context_mode,workspace_context_mode,provenance{author,created_at,source_kind,source_ref}}:
  "node --input-type=module -e 'import assert from \"node:assert/strict\";\nimport { readFileSync } from \"node:fs\";\nimport { execFileSync } from \"node:child_process\";\nimport test from \"node:test\";\ntest(\"Hound reconciliation retains the merged-head error and unresolved acceptance\", () => {\n  const path = \".agents/pm/issues/pm-jira-0571.toon\";\n  const item = process.env.PM_JIRA_REVIEW_BASELINE ? execFileSync(\"git\", [\"show\", \"ef8aa9434808c599a9e2630f771b4cec1d1b22d1:\" + path], { encoding: \"utf8\" }) : readFileSync(path, \"utf8\");\n  assert.match(item, /^status: (open|in_progress)$/m);\n  assert.match(item, /^resolution: .*Unresolved:/m);\n  assert.match(item, /^actual_result: .*35e849a2d1522097a416d966b55d6ff3a74bdc1e.*Hound ERROR.*5979159857/m);\n  assert.doesNotMatch(item, /^(closed_at|completed_at|close_reason):/m);\n  const pr = JSON.parse(execFileSync(\"gh\", [\"pr\", \"view\", \"120\", \"-R\", \"unbraind/pm-jira\", \"--json\", \"headRefOid,mergeCommit,statusCheckRollup\"], { encoding: \"utf8\" }));\n  assert.equal(pr.headRefOid, \"35e849a2d1522097a416d966b55d6ff3a74bdc1e\");\n  assert.equal(pr.mergeCommit.oid, \"21d52aec01033ba6ff75050032fe9348837b1cf0\");\n  assert.equal(pr.statusCheckRollup.find(check => check.context === \"Hound\")?.state, \"ERROR\");\n});'",project,180,tracker,source,codex-agent,"2026-10-22T12:11:57.452Z",local_mutation,chore/reconcile-tracker-1021

{"ts":"2026-08-14T06:44:38.580Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"70140e5dd5b320efbbb8d5d3","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-jira-2m0s"},{"op":"add","path":"/metadata/title","value":"The deprecated jira-sync importer alias loses its credential gate when the preflight override is scoped"},{"op":"add","path":"/metadata/description","value":"Found by auditing the class after CodeRabbit reported the same defect in pm-linear. Scoping registerPreflight to a command list narrows which commands the override runs for. The scope listed jira sync, jira import and jira export, but registerImporter also exposes the deprecated config-driven jira-sync alias, which reaches the same network pull. The previously global registration covered it by accident. isMutatingJiraInvocation also returned false for the alias, so even a global registration would not have failed fast on it. Both are now fixed: the alias is in the scope list and the classifier treats it as mutating on the same dry-run terms as jira import. A loop test binds the scope list to the classifier so the two cannot drift apart."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-14T06:44:38.580Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-14T06:44:38.580Z"},{"op":"add","path":"/metadata/author","value":"claude"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"5adf01a3a9a13d8f0cc13f9225117e789552af13bdfdb32cc1a6d41c6d4e2ba6","item_hash_version":2,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}

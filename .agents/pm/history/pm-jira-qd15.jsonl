{"ts":"2026-08-22T17:54:33.023Z","author":"ox-alpha","author_source":"asserted","agent_harness":"pi","agent_model":"stealth/ox-alpha","agent_model_source":"environment","agent_instance":"4e163337e279aaea7f2226bd","agent_provenance":{"model":{"value":"stealth/ox-alpha","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-jira-qd15"},{"op":"add","path":"/metadata/title","value":"Drop inert pm manifest key and guard the closed manifest vocabulary"},{"op":"add","path":"/metadata/description","value":"The pm CLI's extension-manifest vocabulary is a closed set of 18 keys; since pm-cli 2026.8.19 any other manifest.json key yields a manifest_unknown_key warning. This repo carried an inert top-level \"pm\": {\"compatibility\": \"v2\"} key that nothing reads (verified by grep over index.ts, scripts/, and test/), which makes downstream strict-assertion consumers such as unbraind/pm-linear PRs #75/#76 fail with ['manifest_unknown_key','pm_min_version_unmet'] instead of exactly ['pm_min_version_unmet']. This change deletes the inert key, bumps the pinned @unbrained/pm-cli dev dependency to 2026.8.22 (the previous pin predates unknown-key detection), and adds test/manifest-vocabulary.test.ts asserting the manifest produces no manifest_unknown_key findings; no changelog script changes were needed because the scripts already carry unbounded-read --pm-arg flags."},{"op":"add","path":"/metadata/type","value":"Chore"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-22T17:54:33.023Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-22T17:54:33.023Z"},{"op":"add","path":"/metadata/author","value":"ox-alpha"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"d0a7c8dfdbceefa137ea6c682455039a38eb67fca67a9cc70ab3c5a5d8ead3c5","item_hash_version":2,"message":""}
